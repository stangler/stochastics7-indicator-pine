//@version=6
indicator("ストキャス7", shorttitle="Sto7", overlay=false, max_labels_count=500)

// ===== パネル位置調整（上に入れる透明な空行の数）=====
topSpacer = 1

// ===== 入力 =====
grpP = "期間"
p1 = input.int(5,  "短期1", minval=1, group=grpP)
p2 = input.int(8,  "短期2", minval=1, group=grpP)
p3 = input.int(13, "中期1", minval=1, group=grpP)
p4 = input.int(21, "中期2", minval=1, group=grpP)
p5 = input.int(34, "中期3", minval=1, group=grpP)
p6 = input.int(55, "長期1", minval=1, group=grpP)
p7 = input.int(89, "長期2", minval=1, group=grpP)

grpL = "判定"
smoothK  = input.int(1, "%K平滑化", minval=1, group=grpL)
obLevel  = input.float(80, "買われすぎライン", group=grpL)
osLevel  = input.float(20, "売られすぎライン", group=grpL)
needCnt  = input.int(7, "判定に必要な本数", minval=1, maxval=7, group=grpL)
showSig  = input.bool(true, "シグナル表示", group=grpL)
showTbl  = input.bool(true, "パネル表示", group=grpL)

// ===== 計算 =====
f_sto(len) => ta.sma(ta.stoch(close, high, low, len), smoothK)

s1 = f_sto(p1)
s2 = f_sto(p2)
s3 = f_sto(p3)
s4 = f_sto(p4)
s5 = f_sto(p5)
s6 = f_sto(p6)
s7 = f_sto(p7)

// 短期＝青系（濃い青・薄い青）、中期＝黄系（薄い黄・黄・濃い黄）、長期＝赤系（薄い赤・濃い赤）
c1 = color.rgb(30, 70, 220)
c2 = color.rgb(120, 190, 255)
c3 = color.rgb(255, 240, 100)
c4 = color.rgb(255, 210, 0)
c5 = color.rgb(200, 150, 0)
c6 = color.rgb(255, 140, 140)
c7 = color.rgb(190, 20, 20)

plot(s1, "短期1", c1)
plot(s2, "短期2", c2)
plot(s3, "中期1", c3)
plot(s4, "中期2", c4)
plot(s5, "中期3", c5)
plot(s6, "長期1", c6)
plot(s7, "長期2", c7)

hline(obLevel, "買われすぎ", color.new(color.gray, 30), hline.style_dotted)
hline(50, "中央", color.new(color.gray, 60), hline.style_dotted)
hline(osLevel, "売られすぎ", color.new(color.gray, 30), hline.style_dotted)

// ===== 判定 =====
f_state(v) =>
    v >= obLevel ? "買われすぎ" : v <= osLevel ? "売られすぎ" : v >= 50 ? "強気圏" : "弱気圏"

obCnt = (s1 >= obLevel ? 1 : 0) + (s2 >= obLevel ? 1 : 0) + (s3 >= obLevel ? 1 : 0) + (s4 >= obLevel ? 1 : 0) + (s5 >= obLevel ? 1 : 0) + (s6 >= obLevel ? 1 : 0) + (s7 >= obLevel ? 1 : 0)
osCnt = (s1 <= osLevel ? 1 : 0) + (s2 <= osLevel ? 1 : 0) + (s3 <= osLevel ? 1 : 0) + (s4 <= osLevel ? 1 : 0) + (s5 <= osLevel ? 1 : 0) + (s6 <= osLevel ? 1 : 0) + (s7 <= osLevel ? 1 : 0)

allOB = obCnt >= needCnt
allOS = osCnt >= needCnt

avgV = (s1 + s2 + s3 + s4 + s5 + s6 + s7) / 7
totalTxt = avgV >= obLevel ? "買われすぎ状態" : avgV <= osLevel ? "売られすぎ状態" : avgV >= 50 ? "強気状態" : "弱気状態"
totalCol = avgV >= obLevel ? color.red : avgV <= osLevel ? color.lime : color.white

// ===== シグナル =====
sigOB = allOB and not allOB[1]
sigOS = allOS and not allOS[1]

if showSig
    if sigOB
        label.new(bar_index, 100, "買われすぎ", style=label.style_label_down, color=color.new(color.red, 100), textcolor=color.red, size=size.small)
    if sigOS
        label.new(bar_index, 0, "売られすぎ", style=label.style_label_up, color=color.new(color.lime, 100), textcolor=color.lime, size=size.small)

// ===== アラート（買われすぎ・売られすぎ）=====
alertcondition(sigOB, "買われすぎ", "買われすぎ")
alertcondition(sigOS, "売られすぎ", "売られすぎ")

// alert()：1本のアラートで2種類を通知
// freq_once_per_bar = 足の途中で条件を満たした最初のティックで即通知（足ごとに1回）
alertInfo = syminfo.ticker + " [" + timeframe.period + "] "
if sigOB
    alert(alertInfo + "買われすぎ", alert.freq_once_per_bar)
if sigOS
    alert(alertInfo + "売られすぎ", alert.freq_once_per_bar)

// ===== パネル =====
var table tbl = table.new(position.top_left, 1, topSpacer + 9, bgcolor=na, frame_width=0, border_width=0)
panelBg = color.new(color.black, 20)

f_row(r, name, len, v, col) =>
    table.cell(tbl, 0, r + topSpacer, name + "(期間" + str.tostring(len) + "): " + str.tostring(v, "0.00") + " - " + f_state(v), text_color=col, text_halign=text.align_left, text_size=size.small, bgcolor=panelBg)

if barstate.islast and showTbl
    for i = 0 to topSpacer - 1
        table.cell(tbl, 0, i, " ", text_size=size.small, bgcolor=na)
    table.cell(tbl, 0, topSpacer, "ストキャス7 [" + timeframe.period + "]", text_color=color.white, text_halign=text.align_left, text_size=size.normal, bgcolor=panelBg)
    f_row(1, "短期1", p1, s1, c1)
    f_row(2, "短期2", p2, s2, c2)
    f_row(3, "中期1", p3, s3, c3)
    f_row(4, "中期2", p4, s4, c4)
    f_row(5, "中期3", p5, s5, c5)
    f_row(6, "長期1", p6, s6, c6)
    f_row(7, "長期2", p7, s7, c7)
    table.cell(tbl, 0, topSpacer + 8, "総合判定: " + totalTxt, text_color=totalCol, text_halign=text.align_left, text_size=size.small, bgcolor=panelBg)